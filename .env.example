DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173

# Integracion n8n (S5-S6)
N8N_API_KEY=CHANGE_ME_N8N_API_KEY
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=CHANGE_ME_N8N_WEBHOOK_SECRET

# ADMIN inicial: si no existe ningún ADMIN, citas-api lo crea al arrancar con estos datos (mín. 12 caracteres).
# Vacío = no se crea. Nunca se sobrescribe un ADMIN existente.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
