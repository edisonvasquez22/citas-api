# Variables de entorno de citas-api. Copiar a .env (NO se sube a Git) y reemplazar los CHANGE_ME.
# Spring Boot lee variables del entorno; este proyecto no usa librería dotenv: exporta las variables
# en la terminal o configúralas en tu IDE antes de `mvn spring-boot:run`.

# Base de datos (MySQL 8.4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CHANGE_ME

# JWT (mínimo 32 caracteres cada uno, distintos entre sí)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS: origen del frontend
FRONTEND_ORIGIN=http://localhost:5173

# ADMIN inicial (opcional): se crea al arrancar solo si no existe ningún ADMIN. Contraseña mínimo 12 caracteres.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Integración n8n (S5-S6). Sin N8N_WEBHOOK_URL no se envían notificaciones.
N8N_API_KEY=CHANGE_ME
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=CHANGE_ME
